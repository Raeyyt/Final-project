# Copy to ".env" in this folder (backend/) before running the API.
#
# Database (PostgreSQL — recommended, separate from the app)
# -----------------------------------------------------------------
# 1. From the repository root, start Postgres only:
#      docker compose up -d
# 2. Default URL matches docker-compose.yml (user/password/db: school / school / school_management).
# 3. Run the API from backend/ (uvicorn). Tables are created on startup; seed adds admin if DB is empty.

DATABASE_URL=postgresql://school:school@127.0.0.1:5432/school_management

# Optional: SQLite file next to this folder (no Docker). Not recommended if you want DB separated from the app.
# DATABASE_URL=sqlite:///./school_management.db

APP_SECRET_KEY=change-this-to-a-long-random-string
